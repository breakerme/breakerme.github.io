:1}},{"seq":"blue_link_3","name":"blue_link","data":{"title":"中央电视台科教频道","type":"quark_baike","query":null,"contentId":"e4110a7c3969441daa3c00e9ad6496a9","status":1}},{"seq":"blue_link_4","name":"blue_link","data":{"title":"读书","type":"quark_baike","query":null,"contentId":"87b413c592904604997a007e1b7b8322","status":1}},{"seq":"blue_link_5","name":"blue_link","data":{"title":"剑桥大学","type":"quark_baike","query":null,"contentId":"1c919abd43774426a889487038b41bb5","status":1}}],"contentExtInfo":{"contents":[{"title":"内容","nextTitleList":null},{"title":"思想","nextTitleList":null},{"title":"影响","nextTitleList":[{"title":"销量","nextTitleList":null},{"title":"荣誉","nextTitleList":null}]},{"title":"出版","nextTitleList":null},{"title":"作者","nextTitleList":null}],"references":[{"serialNumber":"1","link":"","siteName":"天津人民出版社","date":0,"text":"罗伯特·戴博德．蛤蟆先生去看心理医生[M]．天津：，2020：版权页，前言页，目录页．","tag":""},{"serialNumber":"2","link":"https://tv.cctv.com/2021/11/17/VIDEjlBqI3Bml5odIg8hpzPU211117.shtml","siteName":"央视网","date":0,"text":"[读书]罗伯特·戴博德：《蛤蟆先生去看心理医生》","tag":""},{"serialNumber":"3","link":"","siteName":"工会博览","date":0,"text":"《蛤蟆先生去看心理医生》[J].,2021(18)：55.","tag":""},{"serialNumber":"4","link":"","siteName":"南通日报","date":0,"text":"展颜.困在童年里的蛤蟆先生[N].,2022-03-27(A04).","tag":""},{"serialNumber":"5","link":"https://baijiahao.baidu.com/s?id=1817326312271944957&wfr=spider&for=pc","siteName":"封面新闻百家号","date":0,"text":"《蛤蟆先生去看心理医生》中文版畅销500万作者女儿来华：灵感来自童话《柳林风声》","tag":""},{"serialNumber":"6","link":"http://news.yangtse.com/zncontent/1611484.html","siteName":"扬子晚报网","date":0,"text":"“2021年优秀科普读物推荐书目”发布","tag":""},{"serialNumber":"7","link":"http://lib.smu.edu.cn/article/detail/2463","siteName":"南方医科大学图书馆","date":0,"text":"蛤蟆先生去看心理医生","tag":""}],"brainImg":"","summary":"《蛤蟆先生去看心理医生》是英国心理学家罗伯特·戴博德（Robert de Board，1932年—2020年2月）于1997年首次出版的心理学著作。该书以《柳林风声》中的蛤蟆先生为主角，讲述其因抑郁情绪寻求心理咨询，在咨询师苍鹭的引导下逐步认识自我、实现心理成长的过程。作品融合了人际沟通分析理论（TA），系统阐释“儿童”“父母”“成人”三种自我状态，强调个体应通过觉察与反思摆脱童年模式束缚，建立独立人格。书中提出“人生坐标”概念，揭示早期经历对成年后行为与情绪的深远影响。截至2024年12月，其中文版累计销量达500万册，并入选北京市科学技术协会“2021年优秀科普读物推荐书目”，获中央电视台科教频道《读书》栏目推荐。"}},"axiosId":"711efc13f1c34fbb95dbe295faed4a62","resContentId":"711efc13f1c34fbb95dbe295faed4a62","resTitle":"蛤蟆先生去看心理医生","eagtraceId":"213e057c17876278350645426e09ba"},"clientUcParams":{}},"pageType":"baike","isLogin":false,"isQuark":false,"isPCEnv":true,"ut":"","urlId":"711efc13f1c34fbb95dbe295faed4a62","axiosId":"711efc13f1c34fbb95dbe295faed4a62","eagtraceId":"213e057c17876278350645426e09ba","resTitle":"蛤蟆先生去看心理医生","resContentId":"711efc13f1c34fbb95dbe295faed4a62","isSpider":false,"xRenderType":"ssr","referer":"https://baike.quark.cn/baike?id=711efc13f1c34fbb95dbe295faed4a62","ispreimg":false,"ssrRequestCost":93}}</script><script>try{performance.mark('stage-extra-scripts-end')}catch(e){}</script><script>try{performance.mark('stage-snapshot-start')}catch(e){}</script><script></script><script>try{performance.mark('stage-snapshot-end')}catch(e){}</script><script>
